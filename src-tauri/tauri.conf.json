{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Anima Herramientas de Combate",
  "version": "0.1.0",
  "identifier": "com.gonzalo.anima.herramientas.combate",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Anima Herramientas de Combate",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
